{
  "name": "eatarai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LINE group bot for maintaining a validated restaurant wish list.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.118.0"
  }
}
